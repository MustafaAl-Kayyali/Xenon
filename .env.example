# ════════════════════════════════════════════════════════
#  XENON — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── MongoDB Atlas ─────────────────────────────────────────
# Full connection string from MongoDB Atlas dashboard
DATABASE=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.tk1ot6j.mongodb.net/?appName=Cluster0
DATABASE_PASSWORD=your_mongodb_password_here

# ── JWT Authentication ────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# ── Redis (auto-configured by Docker Compose) ─────────────
# These are set automatically — only override if using external Redis
REDIS_HOST=redis
REDIS_PORT=6379
