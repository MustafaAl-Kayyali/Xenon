                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/complaints/getComplaintsAgainstMe?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                "getComplaintsAgainstMe"
              ],
