            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/complaints/getAllComplaints?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                "getAllComplaints"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "[Admin] Respond To Complaint",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\",\n  \"admin_response\": \"Your complaint has been reviewed and approved. Necessary actions were taken.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/complaints/respondToComplaint/{{complaintId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                "respondToComplaint",
                "{{complaintId}}"
              ]
            }
          }
        }
      ]
    },
