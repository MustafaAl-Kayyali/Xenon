              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/complaints/getComplaintById/{{complaintId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                "getComplaintById",
                "{{complaintId}}"
              ]
            }
          }
        },
        {
          "name": "[User] Cancel Complaint",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/complaints/cancelComplaint/{{complaintId}}",
