{
  "info": {
    "name": "Xenon API - Complaints & Reviews Collection",
    "description": "Postman collection for testing Complaints and Reviews modules in Xenon API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login User / Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token', jsonData.token);",
                  "    console.log('Token saved to environment variable {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Complaints (الشكاوى)",
      "item": [
        {
          "name": "[User] Create Complaint (JSON)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"complaint_type\": \"Service Quality\",\n  \"complaint_title\": \"Delayed service delivery\",\n  \"complaint_message\": \"The service provider arrived 2 hours late and did not fulfill the agreed terms.\",\n  \"complaint_priority\": \"high\",\n  \"vendor_id\": \"{{vendorId}}\",\n  \"booking_id\": \"{{bookingId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/complaints/createComplaint",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                "createComplaint"
              ]
            }
          }
        },
        {
          "name": "[User] Create Complaint (Multipart with Attachments)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "complaint_type",
                  "value": "Service Quality",
                  "type": "text"
                },
                {
                  "key": "complaint_title",
                  "value": "Damaged Items on Delivery",
                  "type": "text"
                },
                {
                  "key": "complaint_message",
                  "value": "Items received were damaged during transport.",
                  "type": "text"
                },
                {
                  "key": "complaint_priority",
                  "value": "high",
                  "type": "text"
                },
                {
                  "key": "vendor_id",
                  "value": "{{vendorId}}",
                  "type": "text"
                },
                {
                  "key": "booking_id",
                  "value": "{{bookingId}}",
                  "type": "text"
                },
                {
                  "key": "attachments",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/complaints/createComplaint",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                "createComplaint"
              ]
            }
          }
        },
        {
          "name": "[User] Get My Complaints",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/complaints/getMyComplaints?page=1&limit=10&status=pending&priority=high",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                "getMyComplaints"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "priority",
                  "value": "high"
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "[User] Get Complaint By ID",
          "request": {
            "auth": {
