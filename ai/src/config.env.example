# Xenon AI advisor service configuration.
# Copy to src/config.env and fill in. src/config.env is gitignored and must never be committed.
#   cp src/config.env.example src/config.env
# Loaded by src/loadEnv.js at startup, mirroring the backend's src/config.env convention.
# Real environment variables take precedence over this file.

# ---------------------------------------------------------------- server
AI_PORT=3100
# Bind to loopback. Only widen to 0.0.0.0 if the backend runs on another host,
# and only with AI_API_KEY set: this service reads the package database directly.
AI_HOST=127.0.0.1

# ---------------------------------------------------------------- database
# Use the same cluster as the backend. If the URI carries no database name,
# MONGODB_DATABASE below decides which database is read.
DATABASE=mongodb://127.0.0.1:27017
DATABASE_PASSWORD=
# The database holding `packages` and `packagedetails`. This MUST match where the
# backend actually writes. A mismatch here returns "no packages available" for every query.
MONGODB_DATABASE=test
# Separate database for AI-only data: destination profiles and conversation state.
AI_DATABASE_NAME=XenonAI

# ---------------------------------------------------------------- security
# REQUIRED. Must equal AI_SERVICE_API_KEY in backend/src/config.env. Minimum 16 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_API_KEY=
# Only for an isolated local run with no key at all. Never enable outside your own machine.
AI_ALLOW_ANONYMOUS=false
# Comma-separated exact origins. Empty means no browser may call this service directly,
# which is correct when only the backend talks to it. `*` is refused unless AI_ALLOW_ANY_ORIGIN=true.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- language model
# Optional. When disabled or unreachable, a multilingual rule-based parser is used instead.
OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=10000

# ---------------------------------------------------------------- external services
# Applies to weather (Open-Meteo) and currency (Frankfurter) lookups.
EXTERNAL_API_TIMEOUT_MS=5000
WEATHER_CACHE_TTL_MS=600000

# ---------------------------------------------------------------- limits
PACKAGE_CURRENCY=JOD
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_MS=30000
MAXIMUM_BODY_BYTES=16384

# ---------------------------------------------------------------- conversations
CONVERSATION_TTL_MS=1800000
MAXIMUM_CONVERSATIONS=10000
# Persists follow-up context to AI_DATABASE_NAME with a TTL index, so a restart does not
# drop every in-flight conversation. Falls back to memory only if the write fails.
AI_CONVERSATION_PERSISTENCE=true
